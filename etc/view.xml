<?xml version="1.0"?>
<view xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Config/etc/view.xsd">
    <media>
        <images module="Magento_Catalog">
            <image id="category_page_grid" type="small_image"><width>300</width><height>300</height></image>
            <image id="product_page_main_image" type="image"><width>1000</width><height>1000</height></image>
            <image id="product_page_image_small" type="thumbnail"><width>160</width><height>160</height></image>
            <image id="product_page_image_medium" type="image">
                <width>1000</width>
                <height>1000</height>
                <aspect_ratio>true</aspect_ratio>
                <frame>true</frame>
            </image>
            <image id="product_page_image_large" type="image">
                <width>1000</width>
                <height>1000</height>
                <aspect_ratio>true</aspect_ratio>
                <frame>true</frame>
            </image>
        </images>
    </media>
</view>