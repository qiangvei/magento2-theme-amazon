<?php
/**
 * User dropdown menu for Amazon-style header
 */

use Magento\Customer\Model\Session as CustomerSession;

/** @var \Magento\Framework\View\Element\Template $block */
$customerSession = \Magento\Framework\App\ObjectManager::getInstance()->get(CustomerSession::class);
$isLoggedIn = $customerSession->isLoggedIn();
$triggerUrl = $isLoggedIn ? $block->getUrl('customer/account') : $block->getUrl('customer/account/login');

$menuItems = $isLoggedIn ? [
    ['label' => __('My Account'), 'url' => $block->getUrl('customer/account')],
    ['label' => __('My Orders'), 'url' => $block->getUrl('sales/order/history')],
    ['label' => __('Address Book'), 'url' => $block->getUrl('customer/address')],
    ['label' => __('Sign Out'), 'url' => $block->getUrl('customer/account/logout')],
] : [
    ['label' => __('Sign In'), 'url' => $block->getUrl('customer/account/login')],
    ['label' => __('Create an Account'), 'url' => $block->getUrl('customer/account/create')],
];
?>
<div class="user-account-dropdown">
    <a href="<?= $block->escapeUrl($triggerUrl) ?>" class="user-account-trigger" aria-label="<?= $block->escapeHtmlAttr(__('User')) ?>">
        <span class="user-account-icon" aria-hidden="true"></span>
    </a>
    <ul class="user-account-menu">
        <?php foreach ($menuItems as $item): ?>
            <li>
                <a href="<?= $block->escapeUrl($item['url']) ?>"><?= $block->escapeHtml($item['label']) ?></a>
            </li>
        <?php endforeach; ?>
    </ul>
</div>
